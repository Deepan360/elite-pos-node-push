<body class="g-sidenav-show   bg-gray-100">
    {{>sidebar}}
    <main class="main-content position-relative border-radius-lg ">
        {{>navbar}}
        <div class="table-responsive container-fluid py-4">
            <div class="form-control card">
                <h3>HSN Sales</h3>
                <div class="align-right-top">
                    <div id="filterDateDiv" class="mb-3">
                        <label for="fromDate">From Date:</label>
                        <input type="text" id="fromDate">
                        <label for="toDate">To Date:</label>
                        <input type="text" id="toDate">
                        <button class="btn btn-primary" id="filter-button">Filter</button>
                        <button class="btn btn-primary" id="clear-button">Clear</button>
                    </div>
                </div>
                <div class="fetch-data">
                    <button id="download-gst-report" class="btn btn-success btn-gst ">Download GST Report</button>

                </div>
                <form action="/auth/customer" method="get">
                    <table id="customerTable" class="table-responsive justify-content-between align-items-end"
                        style="width:100% !important">
                        <thead>
                            <tr>
                                <th>HSN Code</th>
                                <th>Product Name</th>
                                <th>Customer Name</th>
                                <th>Bill Id</th>
                                <th>Bill Date</th>
                                <th>Quantity</th>
                                <th>Tax Rate</th>
                                <th>Discount</th>
                                <th>CGST</th>
                                <th>SGST</th>
                                <th>IGST</th>
                                <th>Total Taxable Amount</th>
                                <th>Total Amount</th>

                            </tr>
                        </thead>
                        <tbody>
                            <!-- Add your data rows here -->
                        </tbody>
                    </table>
                </form>
            </div>
        </div>
        {{>footer}}
    </main>
    {{>color}}
    <!-- Datepicker Initialization -->
    <script>

        async function generateGSTReport() {
            const fromDate = $("#fromDate").val();
            const toDate = $("#toDate").val();

            try {
                // Fetch Data
                const taxSlabData = await $.get("/auth/GetHSNSales_TaxSlab", { fromDate, toDate });
                const billRangeData = await $.get("/auth/GetHSNSales_BillRange", { fromDate, toDate });
                const hsnData = await $.get("/auth/GetHSNSales_HSNWise", { fromDate, toDate });
                const GetPurchase_CDNR = await $.get("/auth/GetPurchase_CDNR", { fromDate, toDate });
                const GetPurchase_B2BINV = await $.get("/auth/GetPurchase_B2BINV", { fromDate, toDate });
                const GetPurchase_B2BPURC = await $.get("/auth/GetPurchase_B2BPURC", { fromDate, toDate });  

                // Create workbook
                const workbook = new ExcelJS.Workbook();

                // Utility function for sheet creation
                function createSheet(sheetName, jsonData) {
                    const sheet = workbook.addWorksheet(sheetName);

                    if (!jsonData || jsonData.length === 0) return sheet;

                    // Add header row
                    const header = Object.keys(jsonData[0]);
                    const headerRow = sheet.addRow(header);

                    // Style header 
                    headerRow.eachCell((cell) => {
                        cell.fill = {
                            type: "pattern",
                            pattern: "solid",
                            fgColor: { argb: "FF1F497D" }, // Dark Blue
                        };
                        cell.font = { color: { argb: "FFFFFFFF" }, bold: true };
                        cell.alignment = { vertical: "middle", horizontal: "center" };
                        cell.border = {
                            top: { style: "thin" },
                            left: { style: "thin" },
                            bottom: { style: "thin" },
                            right: { style: "thin" },
                        };
                    });

                    // Add data rows
                    jsonData.forEach((row) => {
                        sheet.addRow(Object.values(row));
                    });

                    // Auto column width
                    sheet.columns.forEach((col) => {
                        let maxLength = 0;
                        col.eachCell({ includeEmpty: true }, (cell) => {
                            const columnLength = cell.value ? cell.value.toString().length : 10;
                            if (columnLength > maxLength) {
                                maxLength = columnLength;
                            }
                        });
                        col.width = maxLength < 15 ? 15 : maxLength;
                    });

                    return sheet;
                }

                // Create sheets
                createSheet("HSN-Wise Report", hsnData.data || hsnData);
                createSheet("Bill Range Summary", billRangeData.data || billRangeData);
                createSheet("Tax Slab Summary", taxSlabData.data || taxSlabData);
                createSheet("Purchase CDNR", GetPurchase_CDNR.data || GetPurchase_CDNR);
                createSheet("Purchase B2BINV", GetPurchase_B2BINV.data || GetPurchase_B2BINV);
                createSheet("Purchase B2BPURC", GetPurchase_B2BPURC.data || GetPurchase_B2BPURC);
               
               
                // Export
                const buffer = await workbook.xlsx.writeBuffer();
                saveAs(new Blob([buffer]), `GST_Report_${fromDate}_to_${toDate}.xlsx`);
                console.log("GST Report Generated Successfully!");
            } catch (error) {
                console.error("Error generating report:", error);
            }
        }
        // Button Click Event
        $("#download-gst-report").on("click", generateGSTReport);

        $(document).ready(function () {
            $("#fromDate, #toDate").datepicker({
                dateFormat: "yy-mm-dd", // Format that matches SQL Date format
                changeMonth: true,
                changeYear: true
            });
        });

        var table = $("#customerTable").DataTable({
            ajax: {
                url: "http://136.185.14.8:8077/auth/hsnsales",
                type: "GET",
                data: function (d) {
                    d.fromDate = $("#fromDate").val();  // Send selected From Date
                    d.toDate = $("#toDate").val();      // Send selected To Date
                },
                dataSrc: "data",
            },
            columns: [
                { data: "hsnCode" },
                { data: "productname" },
                { data: "customername" },
                { data: "Sale_ID" },
                {
                    data: "saledate", render: function (data) {
                        const formattedDate = moment(data).format("DD-MM-YYYY");
                        return formattedDate;
                    }
                },
                { data: "quantity" },
                { data: "tax_rate" },
                { data: "discount" },
                { data: "total_cgst" },
                { data: "total_sgst" },
                { data: "total_igst" },
                { data: "Total_Taxable_Amount" },
                { data: "total_amount" }
            ],
            dom: "Bfrtip",
            buttons: ["copy", "excel", "pdf", "csv"],
            paging: false,
            scrollY: "550px",
            scrollX: true,
            scrollCollapse: true,
            responsive: true,
        });

        $("#filter-button").on("click", function () {
            table.ajax.reload(); // Reload table with filter
        });

        $("#clear-button").on("click", function () {
            $("#fromDate").val("");
            $("#toDate").val("");
            table.ajax.reload(); // Reload table without filter
        });


        $("#filter-button").click(function () {
            table.ajax.reload();
        });

        $("#clear-button").click(function () {
            $("#fromDate, #toDate").val("");
            table.ajax.reload();
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

</body>

</html>