<!DOCTYPE html>
<html lang="en">
<head>
    {{>header}}
  <style>
    #purchaseFormContainer {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #8f8f8f;
        padding: 20px;
        z-index: 1001;
        border-radius: 10px;
    }
    .new-row {
        display: none;
    }
    #manufacturerform {
        display: block;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #8f8f8f;
        padding: 20px;
        z-index: 1000;
        border-radius: 10px;
    }
    .editForm {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
