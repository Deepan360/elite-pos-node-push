        border-radius: 8px;
        overflow: hidden;
    }
    form input,
    select {
        margin: 2px;
    }
    form button {
        width: 100px !important;
        padding: 5px;
        margin: 5px;
    }
    .col input {
        width: 100%;
    }
    input[type=checkbox] {
        width: 100px;
        color: #8f8f8f !important;
    }
    table thead th {
        text-align: center;
    }
    .align-right-top {
        position: absolute;
        top: 0;
        right: 0;
        margin: 10px;
    }
    #dr,
    #cr {
        min-width: 150px;
    }
    .custom-form input[type="date"] {
        width: 100% !important;
    }
    .custom-form {
        display: flex;
        flex-direction: row;
        gap: 5px;
        align-items: center;
    }
    .custom-form button {
        align-items: end !important;
    }
    label>select {
        margin: 2px !important;
    }

</style>

</head>
<body class="g-sidenav-show bg-gray-100">
{{>sidebar}}
    <main class="main-content position-relative border-radius-lg">
        {{>navbar}}

        <div class="table-responsive container-fluid py-4">
            <div class="form-control card">

                            <div style="display: flex;justify-content: space-between;">
                <h3>Multi payment</h3>
<div class="div" style="align-items: end;">
    <button type="button" class="btn btn-success" id="new">New</button>
    <button class="btn btn-info editmasbtn">Edit</button>
    <button type="button" class="btn btn-danger deletemasBtn">Delete</button>
</div>
            </div>
<form id="purchaseDetails" class="custom-form row d-flex" method="post" auth="/auth/multipaymentinsert" >


    <div class="form-group col-md-2">
        <label for="payment_date">payment Date:</label>
        <input type="date" class="form-control" id="payment_date" name="payment_date">
    </div>
<div class="form-group col-md-2">
    <label for="cash_bank_ledger">Cash/Bank Ledger(Dr):</label>
    <select class="form-control" id="cash_bank_ledger" name="cash_bank_ledger">
      <option value="cash/bank select" disabled selected>cash/bank select</option>

    </select>
</div>
<div class="form-group col-md-2">
    <label for="transactionno">Transaction No:</label>
    <input type="text" class="form-control" id="transactionno" name="transactionno">
</div>
<div class="form-group col-md-2">
    <label for="referno">Refer No:</label>
    <input type="text" class="form-control" id="referno" name="referno">
</div>
<div class="form-group col-md-2">
    <label for="remarks">Remarks:</label>
    <input type="text" class="form-control" id="remarks" name="remarks">
</div>
<!-- Supplier Dropdown -->
<div class="form-group col-md-2">
    <label for="supplier_ledger">Supplier Ledger (cr):</label>
    <select class="form-control" id="supplier_ledger" name="supplier_ledger">
        <option value="" disabled selected>Select Supplier</option>
    </select>
</div>

    <div class="form-group col-md-2">
        <label for="amount">Amount:</label>
        <input type="text" class="form-control" id="amount" name="amount">
    </div>
    <div class="form-group col-md-2 d-none">
        <label for="billno">Bill No:</label>
        <input type="hidden" id="billnos" name="billnos[]">

        <input type="text" class="form-control" id="billno" name="billno" readonly>
    </div>
    <div class="form-group col-md-2 ">
        
<button class="btn btn-primary" type="submit">Submit</button>
    </div>
</form>
           

                <table id="customerTable" class="table-responsive justify-content-between align-items-end" style="width:100% !important">
<thead>
    <tr>
        <th>Payment ID</th> <!-- payment_id -->
        <th>Payment Date</th> <!-- paymentdate -->
        <th>Payment Ledger</th> <!-- cashbankledger -->
        <th>Supplier Name</th> <!-- suppliername -->
        <th>Bill No</th> <!-- billno -->
        <th>Transaction No</th> <!-- transactionno -->
        <th>Invoice No</th> <!-- supplierinvoiceno -->
        <th>Invoice Date</th> <!-- supplierinvoicedate -->
        <th>Amount</th> <!-- amount -->
        <th>Refer No</th> <!-- referno -->
        <th>Remarks</th> <!-- remarks -->
    </tr>
</thead>


                    <tbody>
                        <!-- Table body rows will be dynamically added here -->
                    </tbody>
                </table>
                
         
            </div>
            <div id="selectedRowDetails"></div>
            {{>footer}}
        </div>
        <!-- Bootstrap Modal -->
<!-- Modal Structure -->
<!-- Modal Structure -->
<div class="modal fade" id="purchaseDetailsModal" tabindex="-1" aria-labelledby="purchaseDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="purchaseDetailsModalLabel">Credit Purchases</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="paidamount">Paid Amount:</label>
                    <input type="number" class="form-control" id="paidamount" name="paidamount" placeholder="Enter Paid Amount">
                    </div>
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-bordered table-hover" id="purchaseDetailsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Select</th>
                                <th>Purchase ID</th>
                                <th>Date</th>
                                <th>Invoice No</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody id="purchaseDetailsBody"></tbody>
                    </table>
                </div>
                <div class="form-group mt-3">
                    <label for="amount" class="form-label">Total Amount:</label>
                <!-- In Modal -->
                <input type="text" class="form-control" id="modal_total_amount" name="modal_total_amount" readonly>

                </div>  
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-primary" id="submitSelectedAmounts">Submit Selected Amounts</button>
                </div>
            </div>
        </div>
    </div>
</div>
{{>color}}

<script>

    $('#purchaseDetails').on('submit', function (e) {
        e.preventDefault();

        const formData = $(this).serializeArray();
        const billnosRaw = $('#billnos').val();
        const billnos = billnosRaw ? billnosRaw.split(',') : [];

        // Now you have everything you need
        console.log("Form values:", formData);
        console.log("Bill numbers:", billnos);

        // You can send it like this:
        const payload = {
            payment_date: $('#payment_date').val(),
            cash_bank_ledger: $('#cash_bank_ledger').val(),
            supplier_ledger: $('#supplier_ledger').val(),
            transactionno: $('#transactionno').val(),
            referno: $('#referno').val(),
            remarks: $('#remarks').val(),
            amount: $('#amount').val(),
            billnos: billnos
        };

        $.ajax({
            url: '/auth/multipaymentinsert',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (res) {
                console.log('Insert success:', res);
            location.reload();
           
            },
            error: function (xhr) {
                console.error('Insert failed:', xhr);
            }
        });
    });


    $.ajax({
        type: 'GET',
        url: '/auth/multipayment/dr',
        success: function (response) {
            populateDropdown(response.data, 'supplier_ledger');
            console.log(response.data); // Log the response data to check the format of `id` and `ledgername`
        },
        error: function (xhr, status, error) {
            console.error('Error fetching supplier (Dr) options:', error);
        }
    });

    function populateDropdown(data, dropdownId) {
        const $dropdown = $('#' + dropdownId);
        $dropdown.empty().append('<option disabled selected>Select Supplier</option>');

        data.forEach(option => {
            $dropdown.append(
                $('<option>', {
                    value: option.id, // Correctly set the value to the supplier's ID
                    text: option.ledgername // Display the supplier's name in the dropdown
                })
            );
        });
    }


    // When supplier changes, fetch data and open modal
    $('#supplier_ledger').on('change', function () {
        const supplierId = $(this).val();

        if (!supplierId) return;

        $.ajax({
            url: '/auth/suppliermultipaymentlist',
            method: 'GET',
            data: { supplierId: supplierId },
            success: function (response) {
                if (response.success && response.data.length > 0) {
                    const rows = response.data.map(purchase => `
                    <tr>
                        <td>
                            <input type="checkbox" class="purchase-checkbox" 
                                   data-id="${purchase.id}" 
                                   data-amount="${purchase.supplierinvoiceamount}">
                        </td>
                        <td>${purchase.id}</td>
                        <td>${new Date(purchase.supplierinvoicedate).toLocaleDateString()}</td>
                        <td>${purchase.supplierinvoiceno || '-'}</td>
                        <td>${purchase.supplierinvoiceamount}</td>
                    </tr>
                `).join('');
                    $('#purchaseDetailsBody').html(rows);
                } else {
                    $('#purchaseDetailsBody').html('<tr><td colspan="5">No credit purchases found.</td></tr>');
                }

                // Reset modal values
                $('#amount').val('');
                $('#paidamount').val('');
                $('#submitSelectedAmounts').prop('disabled', true);

                // Show modal
                const modal = new bootstrap.Modal(document.getElementById('purchaseDetailsModal'));
                modal.show();
            },
            error: function (xhr, status, error) {
                console.error('Error fetching credit purchases:', error);
            }
        });
    });

    // 🔁 Live update total amount when checkbox changes
    $(document).on('change', '.purchase-checkbox', function () {
        updateTotalAndCompare();
    });

    // 🔁 Live check if paid amount equals total
    $('#paidamount').on('input', function () {
        updateTotalAndCompare();
    });

    function updateTotalAndCompare() {
        let totalAmount = 0;

        $('.purchase-checkbox:checked').each(function () {
            const amount = parseFloat($(this).data('amount')) || 0;
            totalAmount += amount;
        });

        // 💡 Use the modal field ID here
        $('#modal_total_amount').val(totalAmount.toFixed(2));

        const paidAmount = parseFloat($('#paidamount').val()) || 0;

        // Enable button only if matched
        if (totalAmount > 0 && paidAmount === totalAmount) {
            $('#submitSelectedAmounts').prop('disabled', false);
        } else {
            $('#submitSelectedAmounts').prop('disabled', true);
        }
    }

    $('#submitSelectedAmounts').on('click', function () {
        const selectedIds = [];

        $('.purchase-checkbox:checked').each(function () {
            selectedIds.push($(this).data('id'));
        });

        // ✅ Set total amount
        const totalAmount = $('#modal_total_amount').val();
        $('#amount').val(totalAmount);

        // ✅ Store selected bill numbers in hidden input as a comma-separated string
        $('#billnos').val(selectedIds.join(','));

        // ✅ Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('purchaseDetailsModal'));
        modal.hide();
    });


$.ajax({
    url: '/auth/multipayment/cr',
    method: 'GET',
    success: function (response) {
        console.log('Received response for Ledger(dr):', response);
        var options = response.data;
        var $dropdown = $('#cash_bank_ledger'); // Select the dropdown by its ID
      
        // Check if "Cash In" is present in the options
        var cashInPresent = options.some(function(option) {
            return option.ledgername === "Cash";
        });

        // If "Cash In" is not present, add it to the options
        if (!cashInPresent) {
            options.push({ ledgername: "Cash" });
        }

        // Populate the dropdown with options
        if (options && options.length) {
            options.forEach(function (option) {
                // Create an option element and append it to the dropdown
                $dropdown.append($('<option>', {
                    value: option.ledgername,
                    text: option.ledgername
                }));
            });
        } else {
            console.error('No options found for Ledger(dr)');
        }
    },
    error: function (xhr, status, error) {
        console.error('Error fetching options for Ledger(dr):', error);
    }
});




$(document).on('click', '.updateBtn', function(event) {
    event.preventDefault();

var purchaseId = $('#id').val();
if (!purchaseId) {
    console.error('No purchase ID selected.');
    alert('No purchase ID selected. Please select a purchase ID to update.');
    return;
}


    var masterData = {
        payment_date: $('#payment_date').val(),
        cash_bank_ledger: $('#cash_bank_ledger').val(),
        supplier_ledger: $('#supplier_ledger').val(),
        amount: $('#amount').val()
    };

    var transactionData = getUpdatedTransactionData();

    var payload = {
        purchaseId: purchaseId,
        masterData: masterData,
        transactionData: transactionData
    };

    console.log('Payload:', payload);

    $.ajax({
        type: 'PUT',
        url: '/auth/multipaymentedit/' + purchaseId,
        contentType: 'application/json',
        data: JSON.stringify(payload),
        success: function(response) {
            console.log(response);
            if (response.success) {
                alert('Successfully updated');
                window.location.href = "/multipayment";
            } else {
                alert("Failed to update purchase: " + response.message);
            }
        },
        error: function(xhr, status, error) {
            console.error('Error updating purchase:', error);
            alert("Failed to update purchase. Check console for details.");
        }
    });
});



const baseUrl = window.location.origin;

$(document).on('click', '.deletetransBtn', function() {
    var row = $(this).closest('tr');
    var transId = $(this).data('transid'); // Corrected data attribute name

    if (!confirm('Are you sure you want to delete this row?')) {
        return;
    }

    $.ajax({
        type: 'DELETE',
        url: `${baseUrl}/auth/multipaymenttransdelete/${transId}`,
        success: function(response) {
            if (response.success) {
                row.remove();
                alert('Row deleted successfully');
            } else {
                alert('Failed to delete row: ' + response.error);
            }
        },
        error: function(xhr, status, error) {
            console.error('Error deleting row:', error);
            alert('An error occurred while deleting the row.');
        }
    });
});





document.addEventListener('DOMContentLoaded', () => {
  const dropdown = document.getElementById('id');

  // Make AJAX request to fetch dropdown options
  fetch('/auth/multipayment') // Assuming this endpoint is available at '/auth/multipayment'
    .then(response => response.json())
    .then(data => {
      // Check if data.options exists and it's an array
      if (data && Array.isArray(data.options)) {
        data.options.forEach(option => {
          const optionElement = document.createElement('option');
          optionElement.value = option.value;
          optionElement.textContent = option.label;
          dropdown.appendChild(optionElement);
        });
      } else {
        console.error('Data is not in the expected format:', data);
      }
    })
    .catch(error => console.error('Error fetching data:', error));


  // Function to format date as dd-mm-yyyy
function formatDate(dateString) {
  const date = new Date(dateString);
  const day = date.getDate().toString().padStart(2, '0');
  const month = (date.getMonth() + 1).toString().padStart(2, '0');
  const year = date.getFullYear();
  return `${year}-${month}-${day}`;
}

});

        var table = $("#customerTable").DataTable({
            ajax: {
                url: '/auth/multipayment',
                dataType: 'json',
                dataSrc: 'data',
                type: 'GET',
            },
            columns: [
                { data: 'payment_id' },
                {
                    data: 'paymentdate',
                    render: function (data) {
                        console.log('Payment Date:', data);
                        return data && moment(data).isValid() ? moment(data).format("DD-MM-YYYY") : '';
                    }
                },
                { data: 'cashbankledger' },
                { data: 'suppliername' },
                { data: 'billno' },
                { data: 'transactionno' },
                { data: 'supplierinvoiceno' },
                {
                    data: 'supplierinvoicedate',
                    render: function (data) {
                        console.log('Invoice Date:', data);
                        return data && moment(data).isValid() ? moment(data).format("DD-MM-YYYY") : '';
                    }
                },
                { data: 'amount' },
                { data: 'referno' },
                { data: 'remarks' }
            ],
            dom: 'Bfrtip',
            buttons: ['copy', 'excel', 'pdf', 'csv'],
            paging: false,
            scrollY: '480px',
            scrollCollapse: true,
            scrollX: '50px',
            responsive: true,
        });
    

$(document).ready(function () {
    $('.div').hide();
    $('.add').show();
    
    // Select the dropdown using jQuery
    const dropdown = $('#id');
    
    dropdown.on('change', function(event) {
        var selectedOption = $(this).find('option:selected');
        if (selectedOption.val() && selectedOption.val() !== 'view details') {
            $('.div').show();
            $('.opener').hide();
            $('.add').hide();
        } else {
            $('.div').hide();
            $('.add').show();
        }
    });
});



$(document).ready(function() {
    $('#new').click(function() {
       window.location.href = '/multipayment'
    });
});
</script>



